{
  "name": "open-gojs",
  "version": "0.1.0",
  "description": "An open-source TypeScript implementation of GoJS diagramming library",
  "main": "dist/open-gojs.cjs.js",
  "module": "dist/open-gojs.esm.js",
  "browser": "dist/open-gojs.umd.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "serve": "http-server . -p 8080 -c-1 -o",
    "start": "npm run build && npm run serve"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^11.1.6",
    "http-server": "^14.1.1",
    "jsdom": "^29.1.1",
    "rollup": "^4.12.0",
    "rollup-plugin-dts": "^6.1.0",
    "tslib": "^2.6.2",
    "typescript": "^5.4.2",
    "vitest": "^1.3.1"
  },
  "license": "MIT"
}
